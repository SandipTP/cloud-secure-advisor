# ============================================================
# CloudSecure Advisor - Environment Configuration Example
# Copy this file to .env and configure your secrets.
# ============================================================

# Flask Secret Key for session signing
FLASK_SECRET_KEY=your-flask-secret-key-change-in-production

# JWT Secret Key for token signing and authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database URL (defaults to sqlite:///cloudscanner.db)
DATABASE_URL=sqlite:///cloudscanner.db

# Upload directory (defaults to uploads)
UPLOAD_FOLDER=uploads

# Groq Cloud API Key for AI Executive Summaries (Llama 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key_here

# SendGrid Configuration for Password Reset Emails
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your-verified-sender@example.com

# Server host & port configuration
FLASK_HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

